<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<GridPane xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  fx:controller="com.example.tetris.ui.screen.ConfigurationController"
  prefWidth="720" prefHeight="460"
>

  <columnConstraints>
    <ColumnConstraints percentWidth="100" halignment="LEFT"/>
    <ColumnConstraints percentWidth="100" halignment="CENTER"/>
    <ColumnConstraints percentWidth="100" halignment="CENTER"/>
  </columnConstraints>

  <rowConstraints>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
    <RowConstraints percentHeight="100" valignment="CENTER" fillHeight="false"/>
  </rowConstraints>

  <padding>
    <Insets top="16" right="16" bottom="16" left="16"/>
  </padding>

  <!-- Header spans all 3 columns -->
  <!-- TODO: centralize CSS class title -->
  <Label text="Configuration"
    style="-fx-font-size: 20px; -fx-font-weight: bold;"
    GridPane.rowIndex="0" GridPane.columnIndex="0" GridPane.columnSpan="3"
    GridPane.halignment="CENTER"
  />

  <!-- Width -->
  <Label text="Field Width (No of cells):"
    GridPane.rowIndex="1" GridPane.columnIndex="0"
  />
  <Slider fx:id="widthSlider" majorTickUnit="1" blockIncrement="1"
    showTickMarks="true" showTickLabels="true" snapToTicks="true"
    GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="2"
  />

  <!-- Height -->
  <Label text="Field Height (No of cells):"
    GridPane.rowIndex="2" GridPane.columnIndex="0"
  />
  <Slider fx:id="heightSlider" majorTickUnit="1" blockIncrement="1"
    showTickMarks="true" showTickLabels="true" snapToTicks="true"
    GridPane.rowIndex="2" GridPane.columnIndex="1" GridPane.columnSpan="2"
  />

  <!-- Level -->
  <Label text="Game Level:"
    GridPane.rowIndex="3" GridPane.columnIndex="0"
  />
  <Slider fx:id="levelSlider" majorTickUnit="1" blockIncrement="1"
    showTickMarks="true" showTickLabels="true" snapToTicks="true"
    GridPane.rowIndex="3" GridPane.columnIndex="1" GridPane.columnSpan="2"
  />

  <!-- Toggles -->
  <CheckBox fx:id="musicCheck" text="Music"
    GridPane.rowIndex="4" GridPane.columnIndex="0"
    GridPane.halignment="CENTER"
  />
  <CheckBox fx:id="soundCheck" text="Sound"
    GridPane.rowIndex="4" GridPane.columnIndex="1"
  />
  <CheckBox fx:id="extendedCheck" text="Extend Mode"
    GridPane.rowIndex="4" GridPane.columnIndex="2"
  />

  <!-- Players -->
  <Label text="Player 1:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
  <ChoiceBox fx:id="player1Choice" GridPane.rowIndex="5" GridPane.columnIndex="1"
    GridPane.columnSpan="2"
  />

  <Label text="Player 2:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
  <ChoiceBox fx:id="player2Choice" GridPane.rowIndex="6" GridPane.columnIndex="1"
    GridPane.columnSpan="2"
  />

  <!-- Actions -->
  <Button text="Save"
    GridPane.rowIndex="7" GridPane.columnIndex="0"
    onAction="#onSave"
  />
  <Button text="Reset"
    GridPane.rowIndex="7" GridPane.columnIndex="1"
    onAction="#onReset"
  />
  <Button text="Back"
    GridPane.rowIndex="7" GridPane.columnIndex="2"
    onAction="#onBack"
  />
</GridPane>