<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx"
  xmlns:fx="http://javafx.com/fxml"
  fx:controller="com.example.tetris.ui.screen.MenuController"
  alignment="CENTER"
  stylesheets="@style.css"
>
  <Region VBox.vgrow="ALWAYS"/>
  <Button onAction="#onPlayButtonClick" text="Play" styleClass="contrast"/>
  <Region VBox.vgrow="ALWAYS"/>
  <Button onAction="#onHighScoresButtonClick" text="High Scores" styleClass="contrast"/>
  <Region VBox.vgrow="ALWAYS"/>
  <Button onAction="#onConfigurationButtonClick" text="Configuration" styleClass="contrast"/>
  <Region VBox.vgrow="ALWAYS"/>
  <Button onAction="#onExitButtonClick" text="Exit" styleClass="contrast"/>
  <Region VBox.vgrow="ALWAYS"/>
</VBox>
