<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns:fx="http://javafx.com/fxml"
      xmlns="http://javafx.com/javafx"
      fx:controller="com.example.tetris.HelloController"
      alignment="CENTER" spacing="16">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>

    <Button text="Play" onAction="#onPlayButtonClick"/>
    <Button text="High Scores" onAction="#onHighScores"/>
    <Button text="Exit" onAction="#onExitButtonClick"/>
</VBox>